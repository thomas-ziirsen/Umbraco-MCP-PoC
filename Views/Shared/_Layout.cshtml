<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" href="~/favicon.ico" />
    <link rel="stylesheet" href="~/css/events-site.css" asp-append-version="true" />
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="@ViewData["BodyClass"]">
    @RenderBody()
    <script src="~/js/events-site.js" asp-append-version="true"></script>
</body>
</html>